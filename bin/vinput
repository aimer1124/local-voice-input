#!/bin/bash
# vinput — CLI 入口，提供 --version / --doctor 等元命令
#
# 注意：实际的语音输入由 Raycast 触发 vinput_bg.sh，本脚本不会触发录音。
# 这里只处理诊断和版本类查询，方便用户在终端里排错。

set -u

VERSION="1.8.1"
GITHUB_REPO="aimer1124/local-voice-input"
WHISPER_MODEL_NAME="ggml-large-v3-turbo-q5_0.bin"
WHISPER_MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/${WHISPER_MODEL_NAME}"

# ── 默认路径（可被 ~/.config/vinput.conf 覆盖）────────────
WHISPER_DIR="$HOME/.whisper_models"
CONFIG_DIR="$HOME/.config"
CONFIG_FILE="$CONFIG_DIR/vinput.conf"
[ -f "$CONFIG_FILE" ] && source "$CONFIG_FILE"

MODEL_PATH="${MODEL_PATH:-$WHISPER_DIR/ggml-large-v3-turbo-q5_0.bin}"
OLLAMA_MODEL="${OLLAMA_MODEL:-qwen2.5:3b}"
OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434}"
HOTWORDS_FILE="${HOTWORDS_FILE:-$CONFIG_DIR/vinput_hotwords.txt}"
CORRECTIONS_FILE="${CORRECTIONS_FILE:-$CONFIG_DIR/vinput_corrections.tsv}"
HISTORY_FILE="${HISTORY_FILE:-$HOME/.cache/vinput/history.jsonl}"
HUD_BIN="${HUD_BIN:-$WHISPER_DIR/hud}"
RAYCAST_DIR="${RAYCAST_DIR:-$CONFIG_DIR/raycast-scripts}"

# ── 输出工具（颜色 + 段落标题）─────────────────────────
G=$'\033[0;32m'; Y=$'\033[1;33m'; R=$'\033[0;31m'; C=$'\033[0;36m'; N=$'\033[0m'
ok()    { echo "${G}✓${N} $*"; }
warn()  { echo "${Y}⚠${N} $*"; }
err()   { echo "${R}✗${N} $*"; }
hint()  { echo "  ${C}→${N} $*"; }
section() { echo; echo "${C}═══ $* ═══${N}"; }

resolve_file() {
    local path="$1"
    if command -v realpath >/dev/null 2>&1; then
        realpath "$path" 2>/dev/null || printf '%s\n' "$path"
    else
        local src="$path" tgt
        while [ -L "$src" ]; do
            tgt=$(readlink "$src")
            case "$tgt" in
                /*) src="$tgt" ;;
                *)  src="$(dirname "$src")/$tgt" ;;
            esac
        done
        printf '%s\n' "$src"
    fi
}

print_effective_config() {
    section "有效配置"
    printf "  VERSION=%s\n" "$VERSION"
    printf "  WHISPER_DIR=%s\n" "$WHISPER_DIR"
    printf "  MODEL_PATH=%s\n" "$MODEL_PATH"
    printf "  OLLAMA_MODEL=%s\n" "$OLLAMA_MODEL"
    printf "  OLLAMA_URL=%s\n" "$OLLAMA_URL"
    printf "  HOTWORDS_FILE=%s\n" "$HOTWORDS_FILE"
    printf "  CORRECTIONS_FILE=%s\n" "$CORRECTIONS_FILE"
    printf "  HISTORY_FILE=%s\n" "$HISTORY_FILE"
    printf "  HUD_BIN=%s\n" "$HUD_BIN"
    printf "  RAYCAST_DIR=%s\n" "$RAYCAST_DIR"
}

check_runtime_layout() {
    local fails_ref="$1" warns_ref="$2"
    local linked=0 stale=0 f target script_real installed_version

    section "运行目录"
    if [ -d "$WHISPER_DIR" ]; then
        ok "运行目录        $WHISPER_DIR"
    else
        err "运行目录缺失    $WHISPER_DIR"
        eval "$fails_ref=\$(( $fails_ref + 1 ))"
        return
    fi

    for f in vinput vinput.sh vinput_bg.sh hud; do
        if [ -e "$WHISPER_DIR/$f" ]; then
            target=$(resolve_file "$WHISPER_DIR/$f")
            if [ -L "$WHISPER_DIR/$f" ]; then
                ok "$f → $target"
                linked=$((linked + 1))
                if [ "$f" = "vinput" ]; then
                    installed_version=$(printf '%s\n' "$target" | sed -n 's#.*/local-voice-input/\([^/]*\)/.*#\1#p')
                    if [ -n "$installed_version" ] && [ "$installed_version" != "$VERSION" ]; then
                        warn "运行版版本不一致: vinput 链到 ${installed_version}，当前脚本声明 $VERSION"
                        hint "正式使用时运行 brew upgrade local-voice-input && vinput setup；开发调试时可忽略"
                        eval "$warns_ref=\$(( $warns_ref + 1 ))"
                    fi
                fi
            else
                warn "$f 不是软链    $WHISPER_DIR/$f"
                eval "$warns_ref=\$(( $warns_ref + 1 ))"
            fi
        else
            warn "$f 缺失          $WHISPER_DIR/$f"
            eval "$warns_ref=\$(( $warns_ref + 1 ))"
        fi
    done

    script_real=$(resolve_file "${BASH_SOURCE[0]}")
    case "$script_real" in
        "$WHISPER_DIR"/*)
            warn "当前 vinput 从运行目录源码直接执行，通常应通过软链指向安装/开发目录"
            eval "$warns_ref=\$(( $warns_ref + 1 ))"
            ;;
    esac

    for f in hud.swift vinput_bg.sh.bak vinput.old; do
        if [ -e "$WHISPER_DIR/$f" ]; then
            stale=$((stale + 1))
            warn "运行目录残留    $WHISPER_DIR/$f"
            hint "运行目录只应放模型、软链和状态；源码请维护在主仓 src/ 或 bin/ 下"
        fi
    done
    if [ "$stale" -gt 0 ]; then
        eval "$warns_ref=\$(( $warns_ref + $stale ))"
    fi
    [ "$linked" -gt 0 ] && ok "运行入口软链    $linked 个入口已链接"
}

check_raycast_scripts() {
    local fails_ref="$1" warns_ref="$2"
    local expected_bg="$WHISPER_DIR/vinput_bg.sh"
    local expected_home="\$HOME/.whisper_models/vinput_bg.sh"
    local script target expected_name has_dev=0

    section "Raycast 命令"
    if [ ! -d "$RAYCAST_DIR" ]; then
        warn "Raycast 脚本目录缺失: $RAYCAST_DIR"
        hint "运行 vinput setup 安装脚本，或在 Raycast 添加 ~/.config/raycast-scripts"
        eval "$warns_ref=\$(( $warns_ref + 1 ))"
        return
    fi
    ok "Raycast 目录    $RAYCAST_DIR"

    for script in voice-input.sh voice-input-raw.sh voice-input-en.sh; do
        target="$RAYCAST_DIR/$script"
        if [ ! -f "$target" ]; then
            warn "$script 缺失"
            eval "$warns_ref=\$(( $warns_ref + 1 ))"
            continue
        fi
        if [ -x "$target" ]; then
            ok "$script 可执行"
        else
            err "$script 不可执行"
            eval "$fails_ref=\$(( $fails_ref + 1 ))"
        fi
        if grep -Fq "$expected_bg" "$target" || grep -Fq "$expected_home" "$target"; then
            ok "$script 指向运行入口"
        elif grep -Fq "/local-voice-input/bin/vinput_bg.sh" "$target"; then
            warn "$script 指向开发仓库入口"
            hint "发布/正式使用时建议运行 vinput setup，让 Raycast 全部指向 $expected_bg"
            has_dev=1
        else
            warn "$script 未指向标准入口: $expected_bg"
            eval "$warns_ref=\$(( $warns_ref + 1 ))"
        fi
    done

    if [ "$has_dev" = "1" ]; then
        eval "$warns_ref=\$(( $warns_ref + 1 ))"
    fi

    expected_name="voice-input-en.sh"
    if [ -f "$RAYCAST_DIR/$expected_name" ] && ! grep -Fq "VINPUT_TRANSLATE_EN=1" "$RAYCAST_DIR/$expected_name"; then
        warn "$expected_name 存在但未启用 VINPUT_TRANSLATE_EN=1"
        eval "$warns_ref=\$(( $warns_ref + 1 ))"
    fi
}

# ── --version ─────────────────────────────────────────
cmd_version() {
    local sha=""
    if [ -d "$WHISPER_DIR/.git" ]; then
        sha=$(git -C "$WHISPER_DIR" rev-parse --short HEAD 2>/dev/null || true)
    fi
    # 也尝试本项目仓库（开发时直接跑此脚本）
    if [ -z "$sha" ]; then
        local script_dir
        script_dir="$(cd "$(dirname "$0")/.." && pwd)"
        sha=$(git -C "$script_dir" rev-parse --short HEAD 2>/dev/null || true)
    fi

    if [ -n "$sha" ]; then
        echo "local-voice-input $VERSION (commit $sha)"
    else
        echo "local-voice-input $VERSION"
    fi
    echo "https://github.com/$GITHUB_REPO"
}

# ── --doctor ──────────────────────────────────────────
cmd_doctor() {
    local quick=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --quick) quick=1 ;;
            --help|-h)
                cat <<'EOF'
vinput doctor — 运行环境诊断

  --quick   只检查配置、运行目录、Raycast 脚本和工具链；跳过 Ollama、HUD、麦克风运行时探测
EOF
                return 0
                ;;
            *) err "未知参数: $1"; exit 2 ;;
        esac
        shift
    done

    local fails=0 warns=0

    echo "${C}🩺 vinput doctor ($VERSION)${N}"
    print_effective_config

    # ─── 工具链 ───
    section "工具链 (PATH)"
    for tool in sox rec jq whisper-cli ollama afplay osascript; do
        local path
        if path=$(command -v "$tool" 2>/dev/null); then
            ok "$tool $path"
        else
            err "$tool — 未在 PATH 中"
            hint "brew install $(case $tool in whisper-cli) echo whisper-cpp ;; rec|sox) echo sox ;; *) echo $tool ;; esac)"
            ((fails++))
        fi
    done

    check_runtime_layout fails warns
    check_raycast_scripts fails warns

    # ─── 资源 ───
    section "资源文件"
    if [ -f "$MODEL_PATH" ]; then
        local size=$(du -h "$MODEL_PATH" | cut -f1)
        ok "Whisper 模型 ($size)  $MODEL_PATH"
    else
        err "Whisper 模型缺失: $MODEL_PATH"
        hint "重跑 install.sh 自动下载"
        ((fails++))
    fi

    if [ -x "$HUD_BIN" ]; then
        local arch=$(lipo -archs "$HUD_BIN" 2>/dev/null || echo "unknown")
        ok "HUD 二进制 ($arch)  $HUD_BIN"
    else
        err "HUD 二进制缺失或不可执行: $HUD_BIN"
        hint "重跑 install.sh，或手动 swiftc -O src/hud.swift -o $HUD_BIN"
        ((fails++))
    fi

    if [ -f "$CONFIG_FILE" ]; then
        ok "配置文件        $CONFIG_FILE"
    else
        warn "配置文件缺失    $CONFIG_FILE (将使用脚本内置默认值)"
        ((warns++))
    fi

    if [ -f "$HOTWORDS_FILE" ]; then
        local count=$(wc -l < "$HOTWORDS_FILE" | xargs)
        ok "热词词表        $HOTWORDS_FILE ($count 词)"
    else
        warn "热词词表缺失    $HOTWORDS_FILE (将使用脚本内置默认词)"
            ((warns++))
    fi

    if [ "$quick" = "1" ]; then
        section "运行时状态"
        warn "quick 模式已跳过 Ollama/HUD/麦克风探测"
        ((warns++))
        section "总结"
        if [ "$fails" -eq 0 ] && [ "$warns" -eq 0 ]; then
            ok "${G}一切就绪，可以正常使用。${N}"
            return 0
        fi
        if [ "$fails" -gt 0 ]; then
            err "$fails 项需要修复"
        fi
        if [ "$warns" -gt 0 ]; then
            warn "$warns 项警告（不一定影响使用）"
        fi
        [ "$fails" -gt 0 ] && return 1 || return 0
    fi

    # ─── 运行时 ───
    section "运行时状态"
    if curl -fs --max-time 2 "$OLLAMA_URL/api/tags" >/dev/null 2>&1; then
        local loaded
        loaded=$(curl -fs "$OLLAMA_URL/api/tags" | jq -r ".models[].name" 2>/dev/null)
        if echo "$loaded" | grep -Fxq "$OLLAMA_MODEL"; then
            ok "Ollama 运行中   $OLLAMA_MODEL 已可用"
        else
            warn "Ollama 运行中   但 $OLLAMA_MODEL 未拉取"
            hint "ollama pull $OLLAMA_MODEL"
            ((warns++))
        fi
    else
        err "Ollama 未启动   $OLLAMA_URL 无响应"
        hint "brew services start ollama  或  ollama serve &"
        ((fails++))
    fi

    if [ -x "$HUD_BIN" ]; then
        if "$HUD_BIN" "🩺 doctor 启动 HUD" 0.5 >/dev/null 2>&1 & disown 2>/dev/null; then
            ok "HUD 可启动      屏幕上应该闪过一个测试 HUD"
        fi
    fi

    # ─── 麦克风 ───
    section "麦克风测试 (3 秒，请保持安静或说话均可)"
    # 在 system_profiler 输出里：设备名是 8 空格缩进的 "DeviceName:" 段头，
    # "Default Input Device: Yes" 出现在它下面的属性区。
    local default_input
    default_input=$(system_profiler SPAudioDataType 2>/dev/null | awk '
        /^ {8}[^ ].*:$/ {
            dev=$0
            sub(/[ :]+$/, "", dev)
            sub(/^[ ]+/, "", dev)
        }
        /Default Input Device: Yes/ { print dev; exit }
    ')
    if [ -n "$default_input" ]; then
        ok "默认输入设备    $default_input"
        if echo "$default_input" | grep -qiE "external|teams|virtual"; then
            warn "  这看起来不是内置麦，常见原因是插着无麦的有线耳机"
            ((warns++))
        fi
    else
        warn "无法读取默认输入设备 (system_profiler 异常)"
        ((warns++))
    fi

    if command -v rec >/dev/null 2>&1; then
        local wav=$(mktemp -t vinput-doctor.XXXXXX).wav
        rec -q -c 1 -r 16000 -b 16 "$wav" trim 0 3 2>/dev/null
        if [ -s "$wav" ]; then
            local rms max
            rms=$(sox "$wav" -n stat 2>&1 | awk '/RMS *amplitude/ {print $3}')
            max=$(sox "$wav" -n stat 2>&1 | awk '/Maximum amplitude/ {print $3}')
            if awk "BEGIN {exit !($rms > 0.01)}"; then
                ok "录音信号       RMS=$rms  Max=$max — 健康"
            elif awk "BEGIN {exit !($rms > 0.002)}"; then
                warn "录音信号       RMS=$rms  Max=$max — 偏弱"
                hint "可能你没说话，或麦克风音量太低"
                ((warns++))
            else
                err "录音信号       RMS=$rms — 几乎纯静音"
                hint "1) 检查系统设置 → 声音 → 输入，确认选了 MacBook Pro Microphone"
                hint "2) 拔掉只能听不能说的有线耳机"
                hint "3) 在系统设置 → 隐私 → 麦克风 中授权 Raycast / sox"
                ((fails++))
            fi
        else
            err "录音失败       rec 没生成有效 WAV"
            hint "检查麦克风权限：系统设置 → 隐私 → 麦克风"
            ((fails++))
        fi
        rm -f "$wav"
    fi

    # ─── 总结 ───
    section "总结"
    if [ "$fails" -eq 0 ] && [ "$warns" -eq 0 ]; then
        ok "${G}一切就绪，可以正常使用。${N}"
        return 0
    fi
    if [ "$fails" -gt 0 ]; then
        err "$fails 项需要修复"
    fi
    if [ "$warns" -gt 0 ]; then
        warn "$warns 项警告（不一定影响使用）"
    fi
    [ "$fails" -gt 0 ] && return 1 || return 0
}

# ── --setup ───────────────────────────────────────────
# 解析自身脚本所在的实际路径（穿透符号链接），用于定位仓库/brew 资源
resolve_resource_root() {
    local src="${BASH_SOURCE[0]}"
    while [ -L "$src" ]; do
        local tgt; tgt=$(readlink "$src")
        case "$tgt" in
            /*) src="$tgt" ;;
            *)  src="$(dirname "$src")/$tgt" ;;
        esac
    done
    # 资源根 = 包含此脚本的 bin/ 的父目录
    # Brew 布局:   <prefix>/libexec/bin/vinput  → <prefix>/libexec
    # Git clone:   <repo>/bin/vinput            → <repo>
    (cd "$(dirname "$src")/.." && pwd)
}

cmd_setup() {
    echo "${C}🚀 vinput setup ($VERSION)${N}"

    local root; root=$(resolve_resource_root)
    if [ ! -d "$root" ]; then
        err "无法解析资源目录: $root"
        return 1
    fi
    ok "资源根目录    $root"

    # ─── 依赖检查 ───
    section "1/6 依赖检查"
    if ! command -v brew >/dev/null 2>&1; then
        err "未检测到 Homebrew（https://brew.sh）"
        return 1
    fi
    ok "Homebrew 已安装"
    for pkg in sox jq whisper-cpp ollama; do
        if brew list "$pkg" >/dev/null 2>&1 || command -v "${pkg/whisper-cpp/whisper-cli}" >/dev/null 2>&1; then
            ok "$pkg"
        else
            warn "$pkg 缺失 — 正在安装"
            brew install "$pkg"
        fi
    done

    # ─── Whisper 模型 ───
    section "2/6 Whisper 模型"
    mkdir -p "$WHISPER_DIR"
    if [ -f "$WHISPER_DIR/$WHISPER_MODEL_NAME" ]; then
        ok "已存在        $WHISPER_DIR/$WHISPER_MODEL_NAME"
    else
        warn "下载约 547MB ..."
        if curl -fL --progress-bar -o "$WHISPER_DIR/${WHISPER_MODEL_NAME}.tmp" "$WHISPER_MODEL_URL"; then
            mv "$WHISPER_DIR/${WHISPER_MODEL_NAME}.tmp" "$WHISPER_DIR/$WHISPER_MODEL_NAME"
            ok "下载完成"
        else
            rm -f "$WHISPER_DIR/${WHISPER_MODEL_NAME}.tmp"
            err "Whisper 模型下载失败"
            return 1
        fi
    fi

    # ─── 链接运行时脚本到 ~/.whisper_models/ ───
    section "3/6 链接运行时脚本"
    local rt_bin="$root/bin"
    [ -d "$rt_bin" ] || rt_bin="$root"  # 兼容旧布局
    for f in vinput vinput.sh vinput_bg.sh; do
        if [ -f "$rt_bin/$f" ]; then
            ln -sfn "$rt_bin/$f" "$WHISPER_DIR/$f"
            ok "$f → $rt_bin/$f"
        else
            warn "$f 在 $rt_bin 中未找到，跳过"
        fi
    done
    # HUD：brew 布局会放在 <prefix>/libexec/bin/hud；repo 布局没有，按需编译/下载
    if [ -x "$rt_bin/hud" ]; then
        ln -sfn "$rt_bin/hud" "$WHISPER_DIR/hud"
        ok "hud → $rt_bin/hud"
    elif command -v swiftc >/dev/null 2>&1 && [ -f "$root/src/hud.swift" ]; then
        warn "编译 HUD（首次需要几秒）"
        swiftc -O "$root/src/hud.swift" -o "$WHISPER_DIR/hud" && ok "hud 编译完成"
    else
        warn "未找到 HUD 二进制，跳过（可手动从 release 下载）"
        hint "curl -L https://github.com/$GITHUB_REPO/releases/latest/download/hud -o $WHISPER_DIR/hud && chmod +x $WHISPER_DIR/hud"
    fi

    # ─── 配置文件 ───
    section "4/6 配置文件"
    mkdir -p "$CONFIG_DIR"
    local conf_src=""
    for cand in "$root/config/vinput.conf.example" "$(brew --prefix 2>/dev/null)/etc/local-voice-input/vinput.conf.example"; do
        [ -f "$cand" ] && conf_src="$cand" && break
    done
    if [ -n "$conf_src" ] && [ ! -f "$CONFIG_FILE" ]; then
        cp "$conf_src" "$CONFIG_FILE"
        ok "写入默认配置  $CONFIG_FILE"
    elif [ -f "$CONFIG_FILE" ]; then
        ok "已有配置      ${CONFIG_FILE}（保留不覆盖）"
    else
        warn "未找到配置模板，跳过"
    fi
    local hot_src=""
    for cand in "$root/config/vinput_hotwords.example.txt" "$(brew --prefix 2>/dev/null)/etc/local-voice-input/vinput_hotwords.example.txt"; do
        [ -f "$cand" ] && hot_src="$cand" && break
    done
    local corr_src=""
    for cand in "$root/config/vinput_corrections.example.tsv" "$(brew --prefix 2>/dev/null)/etc/local-voice-input/vinput_corrections.example.tsv"; do
        [ -f "$cand" ] && corr_src="$cand" && break
    done
    if [ -n "$corr_src" ] && [ ! -f "$CORRECTIONS_FILE" ]; then
        cp "$corr_src" "$CORRECTIONS_FILE"
        ok "写入默认纠错表 ${CORRECTIONS_FILE}"
    elif [ -f "$CORRECTIONS_FILE" ]; then
        ok "已有纠错表    ${CORRECTIONS_FILE}（保留不覆盖）"
    fi
    if [ -n "$hot_src" ] && [ ! -f "$HOTWORDS_FILE" ]; then
        cp "$hot_src" "$HOTWORDS_FILE"
        ok "写入默认热词  $HOTWORDS_FILE"
    elif [ -n "$hot_src" ] && [ -f "$HOTWORDS_FILE" ]; then
        # 自动迁移：v1.0.x 留下的"一行一个英文词"格式会让 Whisper 在中文场景下吐 UTF-8 乱码。
        # 判定标准：① 没有中文 ② 平均行长 < 15 字符 ③ 行数 > 10 → 视为 word-list
        if ! grep -q '[一-龥]' "$HOTWORDS_FILE" 2>/dev/null \
           && [ "$(wc -l < "$HOTWORDS_FILE")" -gt 10 ] \
           && [ "$(awk '{s+=length($0); n++} END{print int(s/n)}' "$HOTWORDS_FILE" 2>/dev/null || echo 99)" -lt 15 ]; then
            local backup="${HOTWORDS_FILE}.v1.0.x-backup"
            cp "$HOTWORDS_FILE" "$backup"
            cp "$hot_src" "$HOTWORDS_FILE"
            warn "检测到旧格式热词（一行一个英文词），已自动迁移为语境句版"
            hint "原文件备份在: $backup"
            hint "旧格式在中文 -l zh 下会让 Whisper 输出乱码（v1.1.7 hotfix）"
        else
            ok "已有热词      ${HOTWORDS_FILE}（保留不覆盖）"
        fi
    fi

    # ─── Raycast 脚本 ───
    section "5/6 Raycast 命令脚本"
    local raycast_dir="$HOME/.config/raycast-scripts"
    mkdir -p "$raycast_dir"
    local installed=0
    for rs in voice-input.sh voice-input-raw.sh voice-input-en.sh; do
        local raycast_src="$root/raycast/$rs"
        local raycast_dst="$raycast_dir/$rs"
        if [ -f "$raycast_src" ]; then
            cp "$raycast_src" "$raycast_dst"
            chmod +x "$raycast_dst"
            ok "Raycast 脚本  $raycast_dst"
            installed=$((installed + 1))
        fi
    done
    if [ "$installed" = "0" ]; then
        warn "未找到 Raycast 模板，跳过"
    fi

    # ─── Ollama 模型 ───
    section "6/6 Ollama 模型"
    if ! pgrep -x ollama >/dev/null 2>&1; then
        warn "启动 Ollama 后台服务"
        brew services start ollama >/dev/null 2>&1 || ollama serve >/dev/null 2>&1 &
        sleep 2
    fi
    if ollama list 2>/dev/null | grep -q "$OLLAMA_MODEL"; then
        ok "$OLLAMA_MODEL 已就绪"
    else
        warn "拉取 ${OLLAMA_MODEL}（约 2GB）"
        ollama pull "$OLLAMA_MODEL"
    fi
    # 预热
    curl -s -X POST "$OLLAMA_URL/api/generate" \
        -H "Content-Type: application/json" \
        -d "{\"model\":\"$OLLAMA_MODEL\",\"prompt\":\"hi\",\"stream\":false,\"keep_alive\":\"30m\"}" \
        >/dev/null 2>&1 && ok "已预热"

    # ─── 收尾 ───
    section "完成"
    cat <<EOF
${G}✓ 安装就绪${N}

还差三步手动配置（系统权限无法脚本化）：
  ${C}1.${N} 系统设置 → 隐私 → 麦克风       ✅ Raycast
  ${C}2.${N} 系统设置 → 隐私 → 辅助功能      ✅ Raycast（自动 ⌘V 用）
  ${C}3.${N} Raycast → Extensions → Script Commands
       添加目录: ~/.config/raycast-scripts
       绑快捷键:
         🎙️ 语音输入        ⌘⇧Space  完整流水线（Whisper + LLM）
         📝 语音输入 (Raw)  ⌥Space    只跑 Whisper，跳过 LLM 整形

可选：把 ${C}alias vinput="$(command -v vinput || echo vinput)"${N} 加到 ~/.zshrc
验证：${C}vinput --doctor${N}
EOF
}

# ── corrections / add-correction / remove-correction (#18) ──
# 谐音/同音纠错表（详见 config/vinput_corrections.example.tsv）。
# TSV 一行一组：<正确><TAB><错1><TAB><错2>...，# 开头注释。

_ensure_corrections_file() {
    if [ ! -f "$CORRECTIONS_FILE" ]; then
        mkdir -p "$(dirname "$CORRECTIONS_FILE")"
        : > "$CORRECTIONS_FILE"
    fi
}

cmd_corrections() {
    case "${1:-}" in
        --suggest) shift; cmd_corrections_suggest "$@"; return $? ;;
        --help|-h)
            cat <<'EOF'
vinput corrections — 谐音纠错表

  vinput corrections             列出当前所有纠错规则
  vinput corrections --suggest   从转写历史挖掘纠错候选 + 规则命中健康度
             [--tail N]          只看最近 N 条历史（默认全部）

发现错词后用 vinput add-correction <对> <错> 落库。
EOF
            return 0 ;;
    esac
    if [ ! -f "$CORRECTIONS_FILE" ]; then
        warn "纠错表不存在: $CORRECTIONS_FILE"
        hint "vinput add-correction <对> <错>  追加一条"
        hint "或 cp \"\$(brew --prefix)/etc/local-voice-input/vinput_corrections.example.tsv\" $CORRECTIONS_FILE"
        return 0
    fi
    section "纠错表 $CORRECTIONS_FILE"
    local rules=0 variants=0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|'#'*) continue ;;
        esac
        IFS=$'\t' read -r correct rest <<< "$line"
        [ -z "$correct" ] && continue
        ((rules++))
        local IFS=$'\t'
        # shellcheck disable=SC2086
        set -- $rest
        unset IFS
        local n_variants=$#
        variants=$((variants + n_variants))
        printf "  ${C}%s${N}  ←  " "$correct"
        local sep=""
        for w in "$@"; do
            [ -z "$w" ] && continue
            printf '%s%s' "$sep" "$w"
            sep=" / "
        done
        printf '\n'
    done < "$CORRECTIONS_FILE"
    echo
    ok "共 $rules 条规则、$variants 个错写变体"
}

# ── corrections --suggest (#方向三, v1.8.0) ────────────
# 从 history.jsonl 数据驱动地维护纠错表（长内容地板击穿器）。两部分，全部只读、只建议：
#   1) 规则命中健康度：哪些规则常救场（保留）、哪些从未命中（可剪枝）。
#   2) 未跟踪高频英文词：raw 里反复出现、却不在纠错表/热词里的英文词 —— 候选错词，
#      用户肉眼判断变体（如 Cloud↔Claude）后用 vinput add-correction 落库。
# 不做编辑距离自动配对（留作后续）；绝不自动改 CORRECTIONS_FILE。
cmd_corrections_suggest() {
    local n="all"
    while [ $# -gt 0 ]; do
        case "$1" in
            --tail|-n) shift; n="${1:-all}" ;;
            *) err "未知参数: $1"; exit 2 ;;
        esac
        shift
    done

    if [ ! -f "$HISTORY_FILE" ]; then
        warn "无历史记录: ${HISTORY_FILE}"
        hint "触发几次 Raycast 语音输入积累历史后再回来。"
        return 0
    fi

    local hist
    if [ "$n" = "all" ]; then
        hist=$(cat "$HISTORY_FILE")
    else
        hist=$(tail -n "$n" "$HISTORY_FILE")
    fi
    local total
    total=$(printf '%s\n' "$hist" | grep -c . )

    # ── 1. 规则命中健康度 ──
    section "纠错规则命中（扫了 $total 条历史）"
    local fired
    fired=$(printf '%s\n' "$hist" | jq -r '.rules_fired[]?' 2>/dev/null | sort | uniq -c | sort -rn)
    if [ -n "$fired" ]; then
        printf '%s\n' "$fired" | while read -r cnt rule; do
            [ -z "$cnt" ] && continue
            printf "  ${G}%4s${N}×  %s\n" "$cnt" "$rule"
        done
    else
        hint "历史里还没有任何纠错规则命中。"
    fi

    # 从未命中的规则（可剪枝）：枚举纠错表里每个 correct←wrong，对比 fired 集合。
    if [ -f "$CORRECTIONS_FILE" ]; then
        local fired_keys never="" line c rest w key
        fired_keys=$(printf '%s\n' "$hist" | jq -r '.rules_fired[]?' 2>/dev/null | sort -u)
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in ''|'#'*) continue ;; esac
            IFS=$'\t' read -r c rest <<< "$line"
            [ -z "$c" ] && continue
            local IFS=$'\t'
            for w in $rest; do
                [ -z "$w" ] && continue
                key="${c}←${w}"
                if ! printf '%s\n' "$fired_keys" | grep -qxF "$key"; then
                    never="${never}  ${key}"$'\n'
                fi
            done
            unset IFS
        done < "$CORRECTIONS_FILE"
        if [ -n "$never" ]; then
            section "从未命中的规则（可考虑剪枝）"
            printf '%s' "$never"
        fi
    fi

    # ── 2. 未跟踪的高频英文词（纠错候选）──
    section "高频英文词（候选错词 — 判断变体后 add-correction）"
    local covered_file
    covered_file=$(mktemp)
    {
        [ -f "$CORRECTIONS_FILE" ] && grep -v '^#' "$CORRECTIONS_FILE" | tr '\t' '\n'
        [ -f "$HOTWORDS_FILE" ] && cat "$HOTWORDS_FILE"
    } 2>/dev/null | grep -oE '[A-Za-z][A-Za-z]+' | sort -u > "$covered_file"

    local cand
    cand=$(printf '%s\n' "$hist" | jq -r '.raw // empty' 2>/dev/null \
        | grep -oE '[A-Za-z][A-Za-z]+' \
        | sort | uniq -c | sort -rn \
        | awk -v cf="$covered_file" '
            BEGIN { while ((getline l < cf) > 0) cov[tolower(l)]=1 }
            { tok=$2 }
            tok != "" && !(tolower(tok) in cov) && $1+0 >= 2 { printf "  %4s×  %s\n", $1, tok }
          ')
    rm -f "$covered_file"
    if [ -n "$cand" ]; then
        printf '%s\n' "$cand"
        echo
        hint "确认某词是误识别后：vinput add-correction <正确写法> <这个词>"
    else
        hint "没有出现 ≥2 次、且未被纠错表/热词覆盖的英文词。"
    fi
}

cmd_add_correction() {
    if [ $# -lt 2 ]; then
        err "用法: vinput add-correction <正确写法> <错误写法>"
        exit 2
    fi
    local correct="$1" wrong="$2"
    _ensure_corrections_file

    local found_line="" found_idx=0 idx=0 line c rest
    while IFS= read -r line || [ -n "$line" ]; do
        ((idx++))
        case "$line" in
            ''|'#'*) continue ;;
        esac
        IFS=$'\t' read -r c rest <<< "$line"
        # 大小写不敏感比较 correct 字段
        if [ "$(printf '%s' "$c" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$correct" | tr '[:upper:]' '[:lower:]')" ]; then
            found_line="$line"
            found_idx=$idx
            break
        fi
    done < "$CORRECTIONS_FILE"

    if [ -n "$found_line" ]; then
        # 检查 wrong 是否已存在（只查 variants，跳过 correct 字段）
        IFS=$'\t' read -r _c2 rest2 <<< "$found_line"
        local have_wrong=0
        local IFS=$'\t'
        for w in $rest2; do
            [ -z "$w" ] && continue
            if [ "$(printf '%s' "$w" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$wrong" | tr '[:upper:]' '[:lower:]')" ]; then
                have_wrong=1
                break
            fi
        done
        unset IFS
        if [ "$have_wrong" = "1" ]; then
            warn "已存在: ${correct} ← ${wrong}（跳过）"
            return 0
        fi
        # 追加 wrong 到该行
        awk -v ln="$found_idx" -v add="$wrong" 'NR==ln{print $0"\t"add; next} {print}' "$CORRECTIONS_FILE" > "$CORRECTIONS_FILE.tmp"
        mv "$CORRECTIONS_FILE.tmp" "$CORRECTIONS_FILE"
        ok "追加: $correct ← $wrong"
    else
        # 新建行
        printf '%s\t%s\n' "$correct" "$wrong" >> "$CORRECTIONS_FILE"
        ok "新增: $correct ← $wrong"
    fi
}

cmd_remove_correction() {
    if [ $# -lt 2 ]; then
        err "用法: vinput remove-correction <正确写法> <错误写法>"
        exit 2
    fi
    local correct="$1" wrong="$2"
    [ ! -f "$CORRECTIONS_FILE" ] && { warn "纠错表不存在"; return 0; }

    local target_lc
    target_lc=$(printf '%s' "$correct" | tr '[:upper:]' '[:lower:]')
    local wrong_lc
    wrong_lc=$(printf '%s' "$wrong" | tr '[:upper:]' '[:lower:]')

    local changed=0
    : > "$CORRECTIONS_FILE.tmp"
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ''|'#'*) printf '%s\n' "$line" >> "$CORRECTIONS_FILE.tmp"; continue ;;
        esac
        IFS=$'\t' read -r c rest <<< "$line"
        if [ "$(printf '%s' "$c" | tr '[:upper:]' '[:lower:]')" != "$target_lc" ]; then
            printf '%s\n' "$line" >> "$CORRECTIONS_FILE.tmp"
            continue
        fi
        # 过滤掉匹配的 wrong
        local kept="$c"
        local IFS=$'\t'
        for w in $rest; do
            [ -z "$w" ] && continue
            if [ "$(printf '%s' "$w" | tr '[:upper:]' '[:lower:]')" = "$wrong_lc" ]; then
                changed=1
                continue
            fi
            kept="$kept"$'\t'"$w"
        done
        unset IFS
        # 该行至少要保留 correct + 1 variant；否则整行删除
        if [ "$kept" = "$c" ]; then
            changed=1
            continue
        fi
        printf '%s\n' "$kept" >> "$CORRECTIONS_FILE.tmp"
    done < "$CORRECTIONS_FILE"
    mv "$CORRECTIONS_FILE.tmp" "$CORRECTIONS_FILE"

    if [ "$changed" = "1" ]; then
        ok "已删除: $correct ← $wrong"
    else
        warn "未找到: $correct ← $wrong"
    fi
}

# ── history (#19) ──────────────────────────────────────
# 看转写历史。每条记录 = 一次成功转写，由 vinput_bg.sh 写入 history.jsonl。
# 用法:
#   vinput history                 # 最近 20 条（彩色表格）
#   vinput history --tail 50       # 最近 50 条
#   vinput history --grep PATTERN  # 在 raw/corrected/cleaned 三个字段里 grep
#   vinput history --raw-only      # 只显示 ts + raw 一栏（便于挖错词）
cmd_history() {
    local n=20 grep_pat="" raw_only=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --tail|-n)   shift; n="${1:-20}" ;;
            --grep|-g)   shift; grep_pat="${1:-}" ;;
            --raw-only)  raw_only=1 ;;
            --help|-h)
                cat <<'EOF'
vinput history — 看历史转写

  --tail N        显示最近 N 条（默认 20）
  --grep PATTERN  在 raw/corrected/cleaned 字段里正则匹配
  --raw-only      只输出 ts + raw 一列（便于 grep / 挖错词）

提示：发现错词后用 vinput add-correction <对> <错> 加入纠错表。
EOF
                return 0
                ;;
            *) err "未知参数: $1"; exit 2 ;;
        esac
        shift
    done

    if [ ! -f "$HISTORY_FILE" ]; then
        warn "无历史记录: ${HISTORY_FILE}"
        hint "触发一次 Raycast 语音输入后再回来。"
        return 0
    fi

    # 过滤
    local lines
    if [ -n "$grep_pat" ]; then
        # grep 在原 JSONL 上做（每行是一个 JSON 对象，所有字段都是 string），用 -E
        lines=$(grep -E "$grep_pat" "$HISTORY_FILE" 2>/dev/null | tail -n "$n")
    else
        lines=$(tail -n "$n" "$HISTORY_FILE")
    fi

    if [ -z "$lines" ]; then
        warn "无匹配记录"
        return 0
    fi

    if [ "$raw_only" = "1" ]; then
        # 单行格式：ts  raw
        echo "$lines" | jq -r '.ts + "  " + .raw'
        return 0
    fi

    section "vinput history (${HISTORY_FILE})"

    # 逐条彩色渲染
    echo "$lines" | while IFS= read -r line; do
        [ -z "$line" ] && continue
        local ts raw corrected cleaned mode rules audio_ms
        ts=$(printf '%s' "$line" | jq -r '.ts // ""')
        raw=$(printf '%s' "$line" | jq -r '.raw // ""')
        corrected=$(printf '%s' "$line" | jq -r '.corrected // ""')
        cleaned=$(printf '%s' "$line" | jq -r '.cleaned // ""')
        mode=$(printf '%s' "$line" | jq -r '.mode // "?"')
        rules=$(printf '%s' "$line" | jq -r '.rules_fired // [] | join(", ")')
        audio_ms=$(printf '%s' "$line" | jq -r '.audio_ms // 0')

        printf "${C}%s${N}  [%s, %sms audio]\n" "$ts" "$mode" "$audio_ms"
        printf "  raw      : %s\n" "$raw"
        if [ -n "$rules" ]; then
            printf "  ${Y}✎ rules${N}  : %s\n" "$rules"
            printf "  corrected: %s\n" "$corrected"
        fi
        if [ "$corrected" != "$cleaned" ]; then
            printf "  ${G}cleaned${N}  : %s\n" "$cleaned"
        fi
        echo
    done
}

# ── --help ────────────────────────────────────────────
cmd_help() {
    cat <<EOF
vinput — local-voice-input CLI ($VERSION)

用法:
  vinput setup                              一键完成依赖安装/模型下载/脚本部署（首次安装后跑一次）
  vinput --version                          显示版本号
  vinput --doctor [--quick]                 运行诊断检查（配置 / Raycast / 工具链 / 运行时 / 麦克风）
  vinput config                             打印当前生效配置
  vinput corrections [--suggest]            列出谐音纠错规则；--suggest 从历史挖候选+命中健康度
  vinput add-correction <对> <错>           追加一条纠错（自动去重）
  vinput remove-correction <对> <错>        删除一条
  vinput history [--tail N | --grep PAT]   查看转写历史（默认最近 20 条）
  vinput --help                             显示此帮助

触发语音输入：
  通过 Raycast 绑定的快捷键（如 ⌘⇧Space）。本命令不会启动录音。
  调试时也可以直接跑: $HOME/.whisper_models/vinput_bg.sh

详见:
  https://github.com/$GITHUB_REPO
EOF
}

# ── 路由 ──────────────────────────────────────────────
case "${1:-help}" in
    --version|-V|version)         cmd_version ;;
    --doctor|doctor)              shift; cmd_doctor "$@" ;;
    config)                       print_effective_config ;;
    --setup|setup)                cmd_setup ;;
    corrections)                  shift; cmd_corrections "$@" ;;
    add-correction)               shift; cmd_add_correction "$@" ;;
    remove-correction)            shift; cmd_remove_correction "$@" ;;
    history)                      shift; cmd_history "$@" ;;
    --help|-h|help|"")            cmd_help ;;
    *)
        err "未知命令: $1"
        echo
        cmd_help
        exit 2
        ;;
esac
