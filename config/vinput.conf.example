# vinput 配置文件 — 启动时被 vinput.sh / vinput_bg.sh source
#
# 设计原则：开箱即用。下面这些是「大多数人真正会改」的项，已给出推荐默认值。
# 任何变量删掉/留空，脚本都会回退到内置默认，不会报错。
#
# 还想调 Whisper 解码内参、SoX 滤波、动态 prompt、HUD 样式/重录等进阶项？
# 这些默认值已针对「中文 + 程序员场景」调优，一般不用动。
# 需要时见 README「进阶配置」：https://github.com/aimer1124/local-voice-input#-进阶配置

# ===== Whisper ASR =====
MODEL_PATH="$HOME/.whisper_models/ggml-large-v3-turbo-q5_0.bin"
WHISPER_LANG="zh"            # 识别语言；中英混读靠热词 prompt 引导

# ===== Ollama LLM 润色 =====
OLLAMA_MODEL="qwen2.5:3b"    # 换更快/更强的模型见 README「进阶」
OLLAMA_URL="http://localhost:11434"

# 文本短于此字数（中文 1 字 = 1）时跳过 LLM，直接用原始转写，省 1–2 秒
SHORT_TEXT_THRESHOLD=15

# ===== 录音 / 粘贴行为 =====
AUTO_PASTE=1                 # 1 = 自动模拟 ⌘V 粘贴（需「辅助功能」权限）；0 = 只复制到剪贴板
USE_VAD=0                    # 0 = 纯 toggle（推荐，最稳）；1 = 静音自动停（仅安静环境好用）
MAX_REC_SECONDS=30           # 录音硬超时（秒），防止忘按停一直录

# 小声 / 远离麦克风的用户把增益调大：+6 ~ +12。负 = 衰减。
SOX_GAIN_DB=-3

# ===== 热词词表（可选）=====
# 每行一个术语，注入 Whisper prompt 提升专业词命中。文件不存在则用内置默认词表。
HOTWORDS_FILE="$HOME/.config/vinput_hotwords.txt"
